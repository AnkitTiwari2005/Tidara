{
  "expo": {
    "name": "Tidara",
    "slug": "tidara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tidara",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tidara.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#02352C",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 10,
      "package": "com.tidara.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#02352C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tidara to use your location to find service providers near you."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#02352C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1a366f21-c32b-4850-8669-f3a22914079a"
      }
    }
  }
}
